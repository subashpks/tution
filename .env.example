# Copy to .env.local for the app, and to your deploy environment.
# Nothing here is a secret that can be committed. The service role key never
# belongs in this file or in the client bundle.

# demo  — seeded local data, no backend (used for review and design work)
# remote — Supabase project below
VITE_DATA_MODE=demo

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Public origin used to build WhatsApp links. No trailing slash.
VITE_APP_URL=http://localhost:3000

# The academy's WhatsApp number in international format, digits only.
VITE_ACADEMY_WHATSAPP=919000000000

# ---------------------------------------------------------------------------
# Server-side only. Set these with `supabase secrets set`, never in Vite env.
#
# APP_URL          public origin used inside invite / fee messages
# DISPATCH_KEY     shared secret for the scheduled dispatch call
# SUPABASE_*       provided automatically by Supabase Edge Functions
# ---------------------------------------------------------------------------
